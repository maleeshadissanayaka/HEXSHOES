{
  "name": "hexshoes-developer-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "Root-level development orchestration for HEXSHOES services",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev -- --host 127.0.0.1",
    "dev:backend": "npm --prefix backend run dev",
    "dev:ai": "cd ai-service && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "health": "node scripts/health.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
