{
  "name": "hexshoes-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API foundation for HEXSHOES",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src tests scripts",
    "test": "vitest run tests",
    "test:watch": "vitest",
    "seed:products": "tsx scripts/seedProducts.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "firebase-admin": "^13.6.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "oxlint": "^1.87.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  }
}
