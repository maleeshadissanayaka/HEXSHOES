PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Server-side product source: use "fixture" locally/tests or "firestore" explicitly.
PRODUCT_DATA_SOURCE=fixture

# Server-side Firebase Admin credentials only. Never expose these to the frontend.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
